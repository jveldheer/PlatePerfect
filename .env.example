# FoodData Central API Key
# Get a free API key at: https://fdc.nal.usda.gov/api-key-signup.html
# WARNING: This will expose your API key in the browser (client-side).
# For production, consider using a backend proxy to keep the key secure.
VITE_FDC_API_KEY=your_api_key_here

# OpenAI API Key (configured in Settings UI, not needed here)
# VITE_OPENAI_API_KEY=your_openai_key_here
